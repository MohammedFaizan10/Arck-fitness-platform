{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "installCommand": "corepack enable && pnpm install --shamefully-hoist --no-frozen-lockfile"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "corepack enable && pnpm install --shamefully-hoist --no-frozen-lockfile"
    },
    "arckfit-fitness": {
      "root": "artifacts/repfi-fitness",
      "framework": "vite",
      "installCommand": "corepack enable && pnpm install --shamefully-hoist --no-frozen-lockfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "arckfit-fitness"
      }
    }
  ]
}
